// StreamingApp Chat Service Pipeline
// No parameters - uses hardcoded environment variables only
// Region: ap-southeast-1

pipeline {
  agent { label 'ec2-agent' }

  options {
    timestamps()
    buildDiscarder(logRotator(numToKeepStr: '20'))
    disableConcurrentBuilds()
    timeout(time: 1, unit: 'HOURS')
  }

  environment {
    AWS_REGION = 'ap-southeast-1'
    AWS_ACCOUNT_ID = credentials('aws-account-id')
    ECR_REGISTRY = "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"
    IMAGE_TAG = "${BUILD_NUMBER}"
    SERVICE = "streamingapp-chat"
    DOCKERFILE_PATH = "backend/chatService/Dockerfile"
  }

  stages {
    stage('Prepare') {
      steps {
        sh '''
          set -eu
          echo "✅ AWS Account: ${AWS_ACCOUNT_ID}"
          echo "✅ ECR Registry: ${ECR_REGISTRY}"
          echo "   Service: ${SERVICE}"
          echo "   Image Tag: ${IMAGE_TAG}"
          echo "   Region: ${AWS_REGION}"
        '''
      }
    }

    stage('Docker Login') {
      steps {
        sh '''
          set -eu
          echo "🔐 Logging into ECR..."
          aws ecr get-login-password --region ${AWS_REGION} | \
            docker login --username AWS --password-stdin ${ECR_REGISTRY}
          echo "✅ ECR login successful"
        '''
      }
    }

    stage('Build Image') {
      steps {
        sh '''
          set -eu
          echo "🔨 Building Docker image..."
          docker build \
            -t ${ECR_REGISTRY}/${SERVICE}:${IMAGE_TAG} \
            -t ${ECR_REGISTRY}/${SERVICE}:latest \
            -f ${DOCKERFILE_PATH} \
            backend
          echo "✅ Build complete"
        '''
      }
    }

    stage('Push to ECR') {
      steps {
        sh '''
          set -eu
          echo "📤 Pushing images to ECR..."
          docker push ${ECR_REGISTRY}/${SERVICE}:${IMAGE_TAG}
          docker push ${ECR_REGISTRY}/${SERVICE}:latest
          echo "✅ Images pushed successfully"
        '''
      }
    }

    stage('Cleanup') {
      steps {
        sh '''
          echo "🧹 Cleaning up local images..."
          docker rmi ${ECR_REGISTRY}/${SERVICE}:${IMAGE_TAG} ${ECR_REGISTRY}/${SERVICE}:latest || true
          echo "✅ Cleanup complete"
        '''
      }
    }
  }

  post {
    always {
      sh 'docker system prune -f 2>/dev/null || true'
    }
    success {
      echo "✅ Chat Service pipeline completed successfully"
    }
    failure {
      echo "❌ Chat Service pipeline failed"
    }
  }
}
