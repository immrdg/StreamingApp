// StreamingApp Auth Service Pipeline
// Builds from: https://github.com/immrdg/StreamingApp
// Uses IAM instance profile for ECR access

pipeline {
  agent { label 'ec2-agent t3-small' }

  options {
    timestamps()
    buildDiscarder(logRotator(numToKeepStr: '20'))
    disableConcurrentBuilds()
  }

  parameters {
    string(name: 'AWS_REGION', defaultValue: 'ap-southeast-1', description: 'AWS region')
    string(name: 'IMAGE_TAG', defaultValue: '1.0.0', description: 'Docker image tag')
    booleanParam(name: 'PUSH_TO_ECR', defaultValue: true, description: 'Push image to ECR')
  }

  environment {
    AWS_DEFAULT_REGION = "${params.AWS_REGION}"
    SERVICE = "streamingapp-auth"
    BUILD_CONTEXT = "backend"
    DOCKERFILE_PATH = "backend/authService/Dockerfile"
  }

  stages {
    stage('Prepare') {
      steps {
        script {
          env.AWS_ACCOUNT_ID = sh(
            script: 'aws sts get-caller-identity --query Account --output text',
            returnStdout: true
          ).trim()
          env.ECR_REGISTRY = "${env.AWS_ACCOUNT_ID}.dkr.ecr.${params.AWS_REGION}.amazonaws.com"
          
          echo "🔧 Preparing build environment"
          echo "   Service: ${env.SERVICE}"
          echo "   Build Context: ${env.BUILD_CONTEXT}"
          echo "   Dockerfile: ${env.DOCKERFILE_PATH}"
        }
      }
    }

    stage('Docker Login') {
      steps {
        sh '''
          set -e
          aws ecr get-login-password --region "$AWS_REGION" | \
            docker login --username AWS --password-stdin "$ECR_REGISTRY"
        '''
      }
    }

    stage('Ensure Repository') {
      steps {
        sh '''
          set -e
          aws ecr describe-repositories \
            --repository-names "$SERVICE" \
            --region "$AWS_REGION" >/dev/null 2>&1 || \
            aws ecr create-repository \
              --repository-name "$SERVICE" \
              --region "$AWS_REGION" \
              --image-scanning-configuration scanOnPush=true \
              --encryption-configuration encryptionType=AES256 >/dev/null
        '''
      }
    }

    stage('Build Image') {
      steps {
        sh '''
          set -e
          echo "🔨 Building Docker image from $BUILD_CONTEXT..."
          docker build \
            -t "$ECR_REGISTRY/$SERVICE:$IMAGE_TAG" \
            -t "$ECR_REGISTRY/$SERVICE:latest" \
            -f "$DOCKERFILE_PATH" \
            "$BUILD_CONTEXT"
          echo "✅ Build complete"
        '''
      }
    }

    stage('Push to ECR') {
      when {
        expression { return params.PUSH_TO_ECR }
      }
      steps {
        sh '''
          set -e
          docker push "$ECR_REGISTRY/$SERVICE:$IMAGE_TAG"
          docker push "$ECR_REGISTRY/$SERVICE:latest"
        '''
      }
    }

    stage('Cleanup') {
      steps {
        sh '''
          docker rmi "$ECR_REGISTRY/$SERVICE:$IMAGE_TAG" "$ECR_REGISTRY/$SERVICE:latest" || true
        '''
      }
    }
  }

  post {
    success {
      echo "✅ Auth Service pipeline completed successfully"
    }
    failure {
      echo "❌ Auth Service pipeline failed"
    }
  }
}
